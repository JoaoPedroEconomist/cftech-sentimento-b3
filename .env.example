# Exemplo de configuração de variáveis de ambiente
# Copie este arquivo para .env e preencha suas chaves:
# cp .env.example .env

# Chave de API do Google Gemini (obrigatória para etapas de LLM)
GEMINI_API_KEY=your_gemini_api_key_here

# Modelo padrão de LLM (recomendado: gemini-3.8-flash)
LLM_MODEL=gemini-3.8-flash

# Preços por milhão de tokens (USD) para estimativa e controle de custo
# Valores de referência para Gemini 1.5/3.8 Flash:
LLM_PRICE_IN_PER_MTOK=0.075
LLM_PRICE_OUT_PER_MTOK=0.30

# Limite máximo de orçamento por execução em USD (opcional)
LLM_BUDGET_USD=5.00
